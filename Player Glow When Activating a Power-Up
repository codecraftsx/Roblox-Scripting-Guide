local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local userInputService = game:GetService("UserInputService")

local function activatePowerUp(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.E and not gameProcessed then
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.Material = Enum.Material.Neon  -- Change material to Neon
                part.Color = Color3.fromRGB(0, 255, 255)  -- Glow color (cyan)
            end
        end
        wait(5)  -- Glow lasts for 5 seconds

        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.Material = Enum.Material.SmoothPlastic  -- Revert back
            end
        end
    end
end

userInputService.InputBegan:Connect(activatePowerUp)
